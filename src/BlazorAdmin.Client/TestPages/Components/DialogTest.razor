@using BlazorTemplate.Constraints.UI.Flyout
@inherits DialogTemplate<int>

<h1>Close Test</h1>
<h2>PIndex: @PIndex</h2>
Input: @(UI.BuildNumberInput<int>(this).Bind(() => Value).Render())
@UI.BuildButton(this).Primary().Text("关闭").OnClick(CloseAsync).Render()
@code {
    [Parameter] public int PIndex { get; set; }
}
