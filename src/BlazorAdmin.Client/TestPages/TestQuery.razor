@(UI.BuildDictionarySelect(this, options).Multiple().Binds(() => selectedValues).Render())
@(string.Join(", ", selectedValues))
@code {
    ConditionUnit condition = new();
    DateTime? dateTime;
    string[] selectedValues = [];
    Dictionary<string, string> options = new()
    {
        ["test1"] = "test1",
        ["test2"] = "test2",
        ["test3"] = "test3",
        ["test4"] = "test4",
        ["test5"] = "test5",
    };
    public void BuildExpression()
    {
        // ToJson();
        var exp = condition.BuildExpression<BlazorTemplate.Constraints.Models.Permissions.User>();
        jsonResult = exp.ToString();
    }
    string? jsonResult;
    public void ToJson()
    {
        jsonResult = System.Text.Json.JsonSerializer.Serialize(condition, options: new System.Text.Json.JsonSerializerOptions()
        {
            WriteIndented = true
        });
    }

    public async Task Open()
    {
        var r = await UI.ShowDialogAsync<DialogTest, int>("测试");
        UI.Success($"返回结果: {r}");
        if (r > 100)
        {
            throw new Exception("太大啦");
        }
    }

}
