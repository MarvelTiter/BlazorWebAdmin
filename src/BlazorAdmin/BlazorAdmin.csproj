<Project Sdk="Microsoft.NET.Sdk.Web">
	<Import Project="../Shared/Props/pack.settings.props" />
	<Import Project="../Shared/Props/projects.versions.props" />
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType Condition="'$(Configuration)'=='Debug'">Exe</OutputType>
		<OutputType Condition="'$(Configuration)'!='Debug'">WinExe</OutputType>
		<DisableWinExeOutputInference>true</DisableWinExeOutputInference>
		<BlazorDisableThrowNavigationException Condition="$(TargetFramework) == 'net10.0'">true</BlazorDisableThrowNavigationException>
		<IsPackable>true</IsPackable>
		<Version>$(MainProjectVersion)</Version>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="wwwroot/**/*.svg" />
	</ItemGroup>
	
	<ItemGroup>
	  <Content Remove="Langs\zh-CN\index.json" />
	  <Content Remove="Langs\zh-CN\RouterStore.json" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Langs\zh-CN\index.json" />
	  <EmbeddedResource Include="Langs\zh-CN\RouterStore.json" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework) == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
		<PackageReference Include="LegacyBlazorJs" Version="10.0.11.74" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework) == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.10" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LightORM.Providers.Sqlite" Version="2026.8.31.1" />
	</ItemGroup>

	<!--#if(AlwaysFalse)-->
	<ItemGroup>
		<ProjectReference Include="..\BlazorAdmin.Client\BlazorAdmin.Client.csproj" />
		<ProjectReference Include="..\Shared\BlazorTemplates\BlazorTemplate.AppServer\BlazorTemplate.AppServer.csproj" />
		<ProjectReference Include="..\Shared\BlazorTemplates\BlazorTemplate.UI.AntBlazor\BlazorTemplate.UI.AntBlazor.csproj" />
		<ProjectReference Include="..\Shared\BlazorTemplates\SvgContentClassGenerator\SvgContentClassGenerator.csproj">
			<OutputItemType>Analyzer</OutputItemType>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>
	<!--#endif-->
	<!--#if(UseClientProject)-->
	<ItemGroup Condition="'$(CurrentMode)'== 'Package'">
		<ProjectReference Include="..\BlazorAdmin.Client\BlazorAdmin.Client.csproj" />
		<PackageReference Include="BlazorTemplate.AppServer" Version="$(AppServerVersion)" />
	</ItemGroup>
	<!--#endif-->
	<!--#if(!UseClientProject)-->
	<ItemGroup Condition="'$(CurrentMode)'== 'Package'">
		<PackageReference Include="BlazorTemplate.AppServer" Version="$(AppServerVersion)" />
		<PackageReference Include="BlazorTemplate.UI.AntBlazor" Version="$(AntUIVersion)" />
	</ItemGroup>
	<!--#endif-->
	<ItemGroup>
		<Content Update="appsettings.Development.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <None Update="simple.db">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
