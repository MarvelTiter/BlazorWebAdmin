@using System.Diagnostics.CodeAnalysis
@using Microsoft.Extensions.Options
@using BlazorTemplate.ClientCore.Options
@using BlazorTemplate.ClientCore.Store.Models
@using BlazorTemplate.ClientCore.UI
@using BlazorTemplate.ClientCore.Components
@using BlazorTemplate.AppServer
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" no-antblazor-js no-antblazor-css />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @UIService.AddStyles()
    @UIService.UIFrameworkJs()
    @loadResources.Value
    <VLink Href="app.css"></VLink>
    <VLink Href="BlazorAdmin.styles.css"></VLink>
    <HeadOutlet @rendermode="@RenderMode" />
</head>

<body>

    <Routers RenderMode="@RenderMode"></Routers>
    <BlazorTemplate.ClientCore.Components.ReconnectorOutlet @rendermode="@RenderMode"></BlazorTemplate.ClientCore.Components.ReconnectorOutlet>

    @loadBlazorFrameworkScript.Value

    <VScript Src="_content/BlazorTemplate.ClientCore/js/shared-project.js"></VScript>
    <VScript Src="js/BlazorAdmin-project.js"></VScript>

</body>

</html>