<Project Sdk="Microsoft.NET.Sdk.Razor">
	<Import Project="../../Props/projects.versions.props" />
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>MarvelTiter</Authors>
		<Copyright>MIT</Copyright>
		<Description>BlazorWebAdmin模板项目的组件</Description>
		<Version>$(SharedProjectVersion)</Version>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Components\IconSelector\**" />
	  <Content Remove="Components\IconSelector\**" />
	  <EmbeddedResource Remove="Components\IconSelector\**" />
	  <None Remove="Components\IconSelector\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="Components\ConditionBuilder\ConditionGroup.razor" />
	</ItemGroup>


	<ItemGroup>
		<EmbeddedResource Include="Langs\en-US\index.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Langs\zh-CN\index.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="wwwroot\css\font-awesome4.7.min.css" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.10" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='DEBUG'">
	  <ProjectReference Include="..\BlazorTemplate.Constraints\BlazorTemplate.Constraints.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='RELEASE'">
		<PackageReference Include="BlazorTemplate.Constraints" Version="$(ConstraintsVersion)" />
	</ItemGroup>
</Project>
