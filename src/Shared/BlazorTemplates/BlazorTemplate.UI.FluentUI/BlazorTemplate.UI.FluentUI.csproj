<Project Sdk="Microsoft.NET.Sdk.Razor">
	<Import Project="../../Props/projects.versions.props" />
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>MarvelTiter</Authors>
		<Copyright>MIT</Copyright>
		<Description>BlazorWebAdmin模板项目的组件</Description>
		<Version>$(FluentUIVersion)</Version>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0" />
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\BlazorTemplate.ClientCore\wwwroot\icons\*.svg" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BlazorTemplate.UI.FluentUI.Generators\BlazorTemplate.UI.FluentUI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='DEBUG'">
		<ProjectReference Include="..\BlazorTemplate.ClientCore\BlazorTemplate.ClientCore.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='RELEASE'">
		<PackageReference Include="BlazorTemplate.ClientCore" Version="$(ClientCoreVersion)" />
	</ItemGroup>

</Project>
