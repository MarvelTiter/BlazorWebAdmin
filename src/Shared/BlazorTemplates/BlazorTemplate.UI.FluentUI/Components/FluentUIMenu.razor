@using System.Diagnostics.CodeAnalysis
@using Microsoft.FluentUI.AspNetCore.Components
@using BlazorTemplate.ClientCore.Store
<FluentNavMenu Collapsible="@true" Expanded="@(!Collapsed)" CollapsedChildNavigation="@true" Style="flex: 1;">
    @foreach (var item in MenuService.RootMenus)
    {
        <FluentUIMenuItem Route="@item"></FluentUIMenuItem>
    }
</FluentNavMenu>

@code {
    [Parameter, NotNull] public IRouterStore? Router { get; set; }
    BlazorTemplate.ClientCore.Services.IMenuService MenuService => Router.MenuService;
    [Parameter] public bool Horizontal { get; set; }
    [Parameter, NotNull] public IAppStore? App { get; set; }

    bool Collapsed => Horizontal ? false : App.Collapsed;
}
