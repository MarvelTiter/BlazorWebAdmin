@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@using BlazorTemplate.ClientCore.Services
@using BlazorTemplate.ClientCore.Store
@using BlazorTemplate.ClientCore.Store.Models
@using System.Diagnostics.CodeAnalysis
@if (!HasChildren)
{
    <FluentNavItem Href="@Route.RouteUrl" IconRest="@Svg" IconActive="@Svg">
        <span>@RouterStore.GetLocalizerString(Route)</span>
    </FluentNavItem>
}
else
{
    <FluentNavCategory IconRest="@Svg" IconActive="@Svg" Title="@RouterStore.GetLocalizerString(Route)">
        <ChildContent>
            @foreach (var item in Children)
            {
                <FluentUIMenuItem Route="@item"></FluentUIMenuItem>
            }
        </ChildContent>
    </FluentNavCategory>
}

<style>
    .fluent-ui-menu-title {
        display: flex;
        gap: 0.3em;
    }

        .fluent-ui-menu-title .nav-icon {
            color: rgb(64, 158, 255);
        }
</style>

@code {
    [Parameter, NotNull] public RouteMenu? Route { get; set; }

    [Inject, NotNull] IRouterStore? RouterStore { get; set; }
    [Inject, NotNull] IJSRuntime? Js { get; set; }
    [Inject, NotNull] ISvgIconService? SvgIconService { get; set; }

    BlazorTemplate.ClientCore.Services.IMenuService MenuService => RouterStore.MenuService;

    // public RouteMenu Current => Route;
    // public RouteMenu Current => onlyOneChildren ? Children.First() : Route;

    // private bool onlyOneChildren => Children.Count() == 1;

    private bool HasChildren => Children.Length > 0;
    private RouteMenu[]? children;
    private RouteMenu[] Children => children ??= [.. MenuService.GetChildMenus(Route.RouteId)];
    Icon? Svg { get; set; }
    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Route.Icon))
        {
            Svg = SvgIconService.GetCustomIcon(Route.Icon, size: IconSize.Size20);
        }
    }
}
