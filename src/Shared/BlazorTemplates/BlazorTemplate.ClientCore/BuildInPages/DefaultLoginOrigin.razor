@using BlazorTemplate.ClientCore.Utils

<div class="login-background">
    <div class="login-header">
        <h1>@AppOptions.CurrentValue.AppTitle</h1>
    </div>
    <div class="login-container">
        <EditForm Model="@LoginModel" FormName="login" Enhance OnValidSubmit="DoLogin">
            <div class="form-group">
                <label for="username">用户名</label>
                <input type="text" id="username"
                       placeholder="@Localizer["Login.Placeholder.UserName"].Value"
                       name="LoginModel.UserName" />
            </div>

            <div class="form-group">
                <label for="password">登录密码</label>
                <div class="input-wrapper">
                    <input type="password" id="password"
                           name="LoginModel.Password"
                           placeholder="@Localizer["Login.Placeholder.Password"].Value" />
                    <div class="toggle-password" id="togglePwd" title="显示/隐藏密码">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <!-- 眼睛形状 -->
                            <path id="eyepath" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                        </svg>
                    </div>
                </div>
            </div>

            <button type="submit" class="login-btn">
                @Localizer["Login.Buttons.Login"]
            </button>
        </EditForm>
    </div>
</div>

<script type="text/javascript">
    const togglePwd = document.getElementById('togglePwd');
    const pwdInput = document.getElementById('password');
    const eyePath = document.getElementById('eyepath');
    togglePwd.addEventListener('click', function() {
        if (pwdInput.type === 'password') {
            pwdInput.type = 'text';
            // 换成“带斜杠的眼睛”图标，表示当前可见
            eyePath.setAttribute('d', "M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z");
        } else {
            pwdInput.type = 'password';
            // 恢复普通的眼睛图标
            eyePath.setAttribute('d', "M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z");
        }
    });
</script>
@code {
    [Inject, NotNull] IOptionsMonitor<AppSetting>? AppOptions { get; set; }
    [SupplyParameterFromForm(FormName = "login")] public LoginFormModel LoginModel { get; set; } = new();

    [Inject, NotNull] IStringLocalizer? Localizer { get; set; }

    [CascadingParameter(Name = "Login"), NotNull] public ILoginPage? LoginPage { get; set; }

    private async Task DoLogin()
    {
        await LoginPage.HandleLogin(LoginModel);
    }
}