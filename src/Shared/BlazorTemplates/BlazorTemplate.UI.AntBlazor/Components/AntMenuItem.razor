@using System.Linq
@using BlazorTemplate.ClientCore.Services
@using BlazorTemplate.ClientCore.Store.Models
@using BlazorTemplate.ClientCore.Components
@using Microsoft.AspNetCore.Components.Routing
@if (!HasChildren)
{
    @if (!Route.IsGroupHeader)
    {
        <MenuItem RouterLink="@Current.RouteUrl" RouterMatch="NavLinkMatch.All" Title="@RouterStore.GetLocalizerString(Route)">
            <IconTemplate>
                <MIcon ClassName="nav-icon" IconName="@Current.Icon"></MIcon>
            </IconTemplate>
        </MenuItem>
    }
}
else
{
    <SubMenu>
        <TitleTemplate>
            <span class="subtitle_template">
                <Icon>
                    <Component>
                        <MIcon ClassName="nav-icon" IconName="@Route.Icon"></MIcon>
                    </Component>
                </Icon>
                <span>@RouterStore.GetLocalizerString(Route)</span>
            </span>
        </TitleTemplate>
        <ChildContent>
            @foreach (var item in Children)
            {
                <AntMenuItem Route="@item"></AntMenuItem>
            }
        </ChildContent>
    </SubMenu>
}


@code {
    [Parameter, NotNull] public RouteMenu? Route { get; set; }

    [Inject, NotNull] IRouterStore? RouterStore { get; set; }

    IMenuService MenuService => RouterStore.MenuService;

    public RouteMenu Current => Route;

    private bool HasChildren => Children.Length > 0;

    private RouteMenu[]? children;

    private RouteMenu[] Children
    {
        get
        {
            return children ??= [.. MenuService.GetChildMenus(Route.RouteId)];
        }    

    }
}
