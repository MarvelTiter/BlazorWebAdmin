@using BlazorTemplate.ClientCore.Lockup
@typeparam TData
@implements IAsyncDisposable
<div class="ant-table-cell-edit">
    <div class="edit-input">
        <InputBuilder TData="TData" Column="@Column" UI="@UI" Reciver="@Reciver" Data="@Data" Lookup="@Lookup"></InputBuilder>
    </div>
    @if (CellEdit)
    {
        <Button Type="AntDesign.ButtonType.Primary" Size="@ButtonSize.Small" Icon="check" Class="edit-btn" OnClick="@OnSave" AutoLoading></Button>
        <Button Danger Size="@ButtonSize.Small" Icon="close" Class="edit-btn" OnClick="@Cancel"></Button>
    }
</div>

@code {
    [Parameter, NotNull] public ColumnInfo? Column { get; set; }
    [Parameter, NotNull] public IUIService? UI { get; set; }
    [Parameter, NotNull] public object? Reciver { get; set; }
    [Parameter, NotNull] public TData? Data { get; set; }
    [Parameter] public bool CellEdit { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public ILookupService? Lookup { get; set; }
    [Parameter] public CancellationToken RowEditCancelToken { get; set; }
    private object? originalValue;
    private CancellationTokenRegistration registration = default;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        originalValue = Column.GetValue(Data);
        registration = RowEditCancelToken.Register(ResetValue);
    }

    public void ResetValue()
    {
        if (originalValue is not null)
            Column.SetValue(Data, originalValue);
    }

    private async Task Cancel()
    {
        ResetValue();
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    public ValueTask DisposeAsync()
    {
        return registration.DisposeAsync();
    }
}

