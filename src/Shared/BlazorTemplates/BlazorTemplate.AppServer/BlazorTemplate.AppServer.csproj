<Project Sdk="Microsoft.NET.Sdk.Razor">
	<Import Project="../../Props/projects.versions.props"/>
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>MarvelTiter</Authors>
		<Copyright>MIT</Copyright>
		<Description>BlazorWebAdmin模板项目的组件</Description>
		<Version>$(AppServerVersion)</Version>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App"></FrameworkReference>
		<!-- OutputItemType="Analyzer" -->
	</ItemGroup>
	
	<ItemGroup Condition="'$(Configuration)'=='DEBUG'">
	  <ProjectReference Include="..\BlazorTemplate.ClientCore\BlazorTemplate.ClientCore.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='RELEASE'">
		<PackageReference Include="BlazorTemplate.ClientCore" Version="$(ClientCoreVersion)" />
	</ItemGroup>
</Project>

